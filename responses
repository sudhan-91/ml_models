async def invoke_product_bot_stream(self, payload):
    try:
        async for event in self.graph_app.astream_events(payload, version="v1"):
            if event["event"] == "on_llm_stream":
                token = event["data"]["chunk"].content
                if token:
                    yield token
    except Exception:
        print(f'Error in invoke_product_bot_stream {traceback.print_exc()}')
        yield "\n[ERROR]\n"
