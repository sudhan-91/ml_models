import json

async def invoke_product_bot_stream(self, payload):
    try:
        async for event in self.graph_app.astream_events(payload, version="v1"):
            evt = event["event"]
            data = event["data"]
            name = event.get("name")

            # Node started
            if evt == "on_chain_start":
                yield json.dumps({
                    "type": "node_start",
                    "node": name
                }) + "\n"

            # Node finished
            elif evt == "on_chain_end":
                yield json.dumps({
                    "type": "node_end",
                    "node": name,
                    "output": data.get("output")
                }) + "\n"

            # LLM token streaming (optional)
            elif evt == "on_llm_stream":
                chunk = data["chunk"].content
                if chunk:
                    yield json.dumps({
                        "type": "token",
                        "node": name,
                        "value": chunk
                    }) + "\n"

    except Exception as e:
        yield json.dumps({
            "type": "error",
            "message": str(e)
        }) + "\n"
