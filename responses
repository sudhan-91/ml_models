import requests
import time

def wait_until_ready(url, timeout=10):
    start = time.time()
    while time.time() - start < timeout:
        try:
            r = requests.get(url, timeout=0.5)
            if r.status_code == 200:
                print("✅ API service started")
                return True
        except Exception:
            pass
        time.sleep(0.5)

    print("❌ API failed to start")
    return False


wait_until_ready("http://localhost:8000/health")
