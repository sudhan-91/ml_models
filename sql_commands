@app.get("/api/chat")
def get_chat_records(
    chat_id: str,
    db: Session = Depends(get_db)
):
    with db.begin():   # context manager
        records = (
            db.query(ChatHistory)   # ← different table
            .filter(
                ChatHistory.chat_id == chat_id,
                ChatHistory.deleted_time.is_(None)  # optional
            )
            .order_by(ChatHistory.created_time.asc())
            .all()
        )

    if not records:
        return []   # or raise 404 if you prefer

    return records

    
    
    
   
