import win32security
import ntsecuritycon as con
import os

def get_folder_owner(path):
    sd = win32security.GetFileSecurity(path, win32security.OWNER_SECURITY_INFORMATION)
    owner_sid = sd.GetSecurityDescriptorOwner()
    name, domain, _ = win32security.LookupAccountSid(None, owner_sid)
    return f"{domain}\\{name}"

folder_path = r"C:\path\to\folder"
print("Owner:", get_folder_owner(folder_path))


import subprocess

def get_owner(path):
    cmd = ['icacls', path]
    result = subprocess.run(cmd, stdout=subprocess.PIPE, text=True)
    for line in result.stdout.splitlines():
        if line.strip().startswith(path):
            continue
        if "(OI)(CI)(F)" in line or ":(F)" in line:
            return line.split(':')[0].strip()
    return "Unknown"

print(get_owner(r"C:\path\to\folder"))


import os
import configparser

def is_internet_shortcut(file_path):
    if not file_path.lower().endswith(".url"):
        return False

    config = configparser.ConfigParser()
    try:
        config.read(file_path)
        return 'InternetShortcut' in config and 'URL' in config['InternetShortcut']
    except Exception as e:
        return False

