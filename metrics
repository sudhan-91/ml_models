
def compare_sql_outputs(expected_sql: str, predicted_sql: str, conn):
    cursor = conn.cursor()
    
    try:
        cursor.execute(expected_sql)
        expected_result = cursor.fetchall()

        cursor.execute(predicted_sql)
        predicted_result = cursor.fetchall()

        return expected_result == predicted_result
    except Exception as e:
        print(f"Execution error: {e}")
        return False



def execution_metric(example, pred, trace=None):
    ddl = example.ddl
    data = example.get("data", [])
    conn = create_test_db(ddl, data)

    result = compare_sql_outputs(example.sql, pred.sql, conn)
    conn.close()
    return result


trained_agent = BootstrapFewShot(
    DDLToSQLAgent(),
    trainset=train_examples,
    quality_score_fn=execution_metric,
    trace=True
).compile()
