class SmartSQLTool(SQLDatabaseTools):
    def call(self, tool_call: ToolCall):
        sql = tool_call.args.get("query", "")
        result = super().call(tool_call)

        memory_note = {
            "user_query": tool_call.original_input,
            "sql": sql,
        }

        if "rows" in result:
            df = pd.DataFrame(result["rows"])
            row_count = len(df)

            memory_note["row_count"] = row_count

            if row_count <= 50:
                memory_note["summary"] = self.summarize_dataframe(df)
            else:
                memory_note["summary"] = f"{row_count} rows returned. User needs to filter."

        # ✅ Save to memory
        tool_call.agent.memory.add_note(f"SQL Memory:\n{memory_note}")
        return result




